APP_NAME="API Recolectores"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ejemplo.com
APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Base de datos: DB_* (Laravel) y MYSQL_* (contenedor) deben coincidir
DB_DATABASE=api_location
DB_USERNAME=api_location
DB_PASSWORD=cambie-esta-clave
MYSQL_DATABASE=api_location
MYSQL_USER=api_location
MYSQL_PASSWORD=cambie-esta-clave
MYSQL_ROOT_PASSWORD=cambie-esta-clave-root

# Ejecuta las migraciones al iniciar el contenedor
RUN_MIGRATIONS=true

SESSION_DRIVER=database
CACHE_STORE=database
CACHE_HOT_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=cecom

MAIL_MAILER=log

CECOM_URL=https://apps-cecom.cloud
CECOM_APP_ID=
CECOM_APP_KEY=
CECOM_APP_SECRET=

WEBPUSH_SUBJECT=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
